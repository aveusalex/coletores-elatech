<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Declarada só porque `pref_scan_result_permission = android.permission.CAMERA`
        está configurado no Barcode Utility. O app não abre nem usa a câmera. Esse
        caminho configurável (`android.intent.scanResult`) é inerte nesta firmware.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagnosticActivity"
            android:exported="false" />

        <!--
            Sem receiver de manifesto: a ação real do scanner
            (com.xcheng.scanner.action.BARCODE_DECODING_BROADCAST) é implícita e,
            no Android 13, só chega a um receiver registrado em runtime. Ver
            MainActivity.scannerReceiver e docs/scanner/integracao-xcscanner.md.
        -->
    </application>
</manifest>
