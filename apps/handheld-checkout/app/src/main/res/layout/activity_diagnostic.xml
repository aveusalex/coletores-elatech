<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include android:id="@+id/subbar" layout="@layout/include_subbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Permissão -->
            <LinearLayout style="@style/DiagCard" android:orientation="vertical">
                <TextView style="@style/TextCaps" android:textSize="11sp"
                    android:text="@string/diag_perm_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <ImageView android:id="@+id/permIcon" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle" app:tint="@color/success" android:contentDescription="@null" />
                    <TextView android:id="@+id/permStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:textFontWeight="500" android:textSize="16sp"
                        android:textColor="@color/success" />
                </LinearLayout>
            </LinearLayout>

            <!-- Contrato -->
            <LinearLayout style="@style/DiagCard" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView style="@style/TextCaps" android:textSize="11sp"
                    android:text="@string/diag_contract_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:fontFamily="monospace" android:textSize="13sp"
                    android:textColor="@color/on_surface" android:lineSpacingMultiplier="1.4"
                    android:text="@string/diag_contract" />
            </LinearLayout>

            <!-- Fonte -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceButton"
                style="@style/Widget.Elatech.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/diag_source_toggle" />

            <TextView
                android:id="@+id/sourceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.35" />

            <!-- Última leitura -->
            <LinearLayout style="@style/DiagCard" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView style="@style/TextCaps" android:textSize="11sp"
                    android:text="@string/last_reading_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/lastCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:fontFamily="monospace" android:textFontWeight="600"
                    android:textSize="18sp" android:textColor="@color/elatech_navy_deep" />
                <TextView android:id="@+id/lastMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/lastDump" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/dump_bg" android:padding="10dp" android:fontFamily="monospace"
                    android:textSize="12sp" android:textColor="@color/dump_fg" android:lineSpacingMultiplier="1.5"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
